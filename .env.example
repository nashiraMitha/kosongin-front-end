# ============================================================
# 🔧 KOSONGIN FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Salin file ini ke .env.local dan isi nilai-nilai sesuai konfigurasi Anda
# ⚠️  JANGAN commit .env.local ke repository. Gunakan .env.example sebagai template.

# ============================================================
# API CONFIGURATION
# ============================================================
# Base URL untuk Backend API
# Development: http://localhost:3000/api
# Production: https://postgres-production-53aa.up.railway.app/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Timeout untuk API requests (dalam milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
# Nama aplikasi
NEXT_PUBLIC_APP_NAME=Kosongin

# URL aplikasi frontend (untuk konstruksi URL, social sharing, dll)
# Development: http://localhost:3001
# Production: https://kosongin.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Frontend URL (sama dengan APP_URL, untuk kompatibilitas)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001

# Environment: development | staging | production
NEXT_PUBLIC_ENVIRONMENT=development

# ============================================================
# FEATURE FLAGS
# ============================================================
# Enable/disable fitur tertentu untuk testing
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_ENABLE_DEBUG=true

# ============================================================
# THIRD-PARTY SERVICES (Optional)
# ============================================================
# Google Analytics ID (jika menggunakan GA)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Sentry DSN (untuk error tracking, jika menggunakan Sentry)
NEXT_PUBLIC_SENTRY_DSN=

# Hotjar ID (untuk user behavior tracking, jika menggunakan Hotjar)
NEXT_PUBLIC_HOTJAR_ID=

# ============================================================
# THEME & STYLING
# ============================================================
# Default theme mode: light | dark | system
NEXT_PUBLIC_DEFAULT_THEME=light

# Primary color (jika menggunakan theme customization)
NEXT_PUBLIC_PRIMARY_COLOR=#000000

# ============================================================
# AUTHENTICATION & SECURITY
# ============================================================
# Token storage method: localStorage | cookie
# Recommended: cookie (lebih aman)
NEXT_PUBLIC_TOKEN_STORAGE=cookie

# Session timeout (dalam menit)
NEXT_PUBLIC_SESSION_TIMEOUT=60

# ============================================================
# DEVELOPMENT TOOLS
# ============================================================
# Enable Next.js debug information
NEXT_PUBLIC_DEBUG_MODE=false

# Enable verbose logging
NEXT_PUBLIC_VERBOSE_LOGGING=false

# ============================================================
# CLOUDINARY (Optional - untuk image optimization)
# ============================================================
# Cloudinary cloud name (jika menggunakan Cloudinary untuk images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ============================================================
# PAGINATION & LIMITS
# ============================================================
# Default items per page untuk lists
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=10

# Maximum items untuk autocomplete/search results
NEXT_PUBLIC_MAX_SEARCH_RESULTS=20

# ============================================================
# FEATURE-SPECIFIC CONFIGURATION
# ============================================================
# Impulse Shield cooldown duration (dalam jam)
NEXT_PUBLIC_IMPULSE_SHIELD_COOLDOWN_HOURS=24

# Challenge max participants
NEXT_PUBLIC_CHALLENGE_MAX_PARTICIPANTS=1000

# ============================================================
# CATATAN PENTING (IMPORTANT NOTES)
# ============================================================
# 1. ENVIRONMENT VARIABLES PREFIX
#    - NEXT_PUBLIC_* variables akan visible di browser (public)
#    - Jangan simpan secrets di public variables
#    - Untuk secrets, gunakan variables tanpa prefix (hanya di server-side)
#
# 2. ENVIRONMENT FILE HIERARCHY
#    - .env.local (highest priority, development)
#    - .env.${NODE_ENV}.local (environment-specific, highest priority untuk env)
#    - .env.${NODE_ENV} (environment-specific)
#    - .env (fallback)
#    - .env.example (template, tidak di-load)
#
# 3. DEVELOPMENT vs PRODUCTION SETUP
#    Development (.env.local):
#      - NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
#      - NEXT_PUBLIC_APP_URL=http://localhost:3001
#      - NEXT_PUBLIC_ENABLE_DEBUG=true
#
#    Production (.env.production.local):
#      - NEXT_PUBLIC_API_BASE_URL=https://postgres-production-53aa.up.railway.app/api
#      - NEXT_PUBLIC_APP_URL=https://kosongin.vercel.app
#      - NEXT_PUBLIC_ENABLE_DEBUG=false
#
# 4. SENSITIVE DATA HANDLING
#    - API keys yang sensitive harus di-store di .env.local (tidak public)
#    - Jangan pernah commit .env atau .env.*.local ke git
#    - Use Vercel environment variables untuk production secrets
#
# 5. VERCEL DEPLOYMENT
#    - Set environment variables di Vercel project settings
#    - Use Vercel Environment Variables UI, jangan hardcode di config
#    - Different variables untuk preview/production/development
#
# 6. BACKEND API CONNECTION
#    - Pastikan Backend API sudah running sebelum menjalankan frontend
#    - NEXT_PUBLIC_API_BASE_URL harus menunjuk ke Backend API yang benar
#    - Development: http://localhost:3000/api
#    - Production: https://postgres-production-53aa.up.railway.app/api
#
# 7. CORS CONFIGURATION
#    - Backend harus dikonfigurasi untuk allow request dari FRONTEND_URL
#    - Development: http://localhost:3001
#    - Production: https://kosongin.vercel.app
#
# 8. HOTRELOAD & CHANGES
#    - Setelah mengubah environment variables, restart dev server
#    - npm run dev (untuk hot reload)
#    - Changes ke NEXT_PUBLIC_* variables memerlukan full rebuild
